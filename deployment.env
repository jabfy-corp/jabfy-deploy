# Immutable image lock file. Producer workflows update this file through reviewed pull requests.
JABFY_CORE_IMAGE=ghcr.io/jabfy-corp/jabfy-core@sha256:REPLACE_WITH_CORE_DIGEST
JABFY_BUS_IMAGE=ghcr.io/jabfy-corp/jabfy-bus@sha256:REPLACE_WITH_BUS_DIGEST
JABFY_VOICE_IMAGE=ghcr.io/jabfy-corp/jabfy-voice@sha256:REPLACE_WITH_VOICE_DIGEST
JABFY_WEBSITE_FRONTEND_IMAGE=ghcr.io/jabfy-corp/jabfy-website-frontend@sha256:REPLACE_WITH_FRONTEND_DIGEST
JABFY_WEBSITE_BACKEND_IMAGE=ghcr.io/jabfy-corp/jabfy-website-backend@sha256:REPLACE_WITH_BACKEND_DIGEST

# Ollama remains external to the images.
OLLAMA_HOST=http://host.docker.internal:11434
JABFY_FRONTEND_URL=http://localhost:8080

